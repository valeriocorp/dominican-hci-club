# Backend Larimar - SECRETA (solo usar en código de servidor: actions, middleware, utils)
SERVER_URL=http://localhost:3000/

# Security (generar claves seguras en prod)
SECRET_KEY=tu-clave-secreta-aqui-cambia-en-produccion
PUBLIC_SECRET_KEY=tu-clave-publica-aqui

# API Key del negocio para autenticación de customers
# Esta clave se genera desde llovio-dashboard (Configuración > API Keys)
# o via endpoint POST /business/api-keys del backend larimar
BUSINESS_API_KEY=llovio_live_bfeceeea5e5a17d99d87558c962dd9b0116656de4dfbb6001e2744baefbaf803

# Environment
NODE_ENV=development

# Planes
PUBLIC_FREE_PLAN_ID=10
PUBLIC_PREMIUM_PLAN_ID=9
FREE_PLAN_PAYMENT_LINK_ID=85


# Gmail OAuth (used for transactional email)
GMAIL_USER="your-email@example.com"
GMAIL_CLIENT_ID="your-google-oauth-client-id"
GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-gmail-refresh-token"
