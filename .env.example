# Backend Larimar - SECRETA (solo usar en código de servidor: actions, middleware, utils)
SERVER_URL=http://localhost:3000

# Security (generar claves seguras en prod)
SECRET_KEY=tu-clave-secreta-aqui-cambia-en-produccion
PUBLIC_SECRET_KEY=tu-clave-publica-aqui

# API Key del negocio para autenticación de customers
# Esta clave se genera desde llovio-dashboard (Configuración > API Keys)
# o via endpoint POST /business/api-keys del backend larimar
BUSINESS_API_KEY=tu-api-key-del-negocio-aqui

# Environment
NODE_ENV=development
