# ── Backend Larimar (SECRETO — solo en código de servidor: actions, middleware, utils) ──
# Prod: https://api.llovio.com/
SERVER_URL=http://localhost:3000/

# Clave para firma de cookies/sesiones (generar una real en prod)
SECRET_KEY=changeme-generate-a-secure-secret

# API Key del negocio (SECRETO). Se genera en llovio-dashboard (Configuración > API Keys)
# o vía POST /business/api-keys. NUNCA commitear el valor real — solo en Dokploy.
BUSINESS_API_KEY=llovio_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis para sesiones persistentes (Astro session driver). Instancia compartida
# entre clientes; el prefijo por cliente se define con `base` en astro.config.mjs.
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development

# Plan Premium (PÚBLICO — se inlinea en build). Dev: 9, Prod: 2
PUBLIC_PREMIUM_PLAN_ID=9

# ── Gmail OAuth (email transaccional) ──
GMAIL_USER=your-email@example.com
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
