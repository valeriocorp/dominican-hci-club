---
import Layout from '@/layouts/Layout.astro'
import ProfilePremiumPage from '@/components/ProfilePremiumPage'
import { hasActiveMembership } from '@/utils/sessionHelpers'

// Obtener datos del usuario desde la sesión
const { isLoggedIn } = Astro.locals;
const user = await Astro.session?.get('user');
const subscription = await Astro.session?.get('subscription');

// Si no hay usuario, redirigir a login
if (!isLoggedIn || !user) {
  return Astro.redirect('/login');
}

// Defensa en profundidad: este es el dashboard real de miembro. Sin membresía
// premium activa NO se muestra, aunque el middleware no lo hubiera gateado.
if (!hasActiveMembership(subscription)) {
  return Astro.redirect('/profile');
}
---

<Layout
  title="Mi Perfil Premium - Dominican HCI Club"
  description="Gestiona tu cuenta premium y suscripción del Dominican HCI Club"
>
  <ProfilePremiumPage 
    client:load 
    user={user}
    subscription={subscription}
  />
</Layout>
