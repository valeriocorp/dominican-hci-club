---
import Layout from '@/layouts/Layout.astro'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from '@/components/ui/card'
import ButtonWelcomeCard from '@/components/ButtonWelcomeCard'
import { getSessionUser, getSessionSubscription } from '@/utils/sessionHelpers'
import { sendWelcomePremiumEmailInternal } from '@/actions/email'
import { server } from '@/actions'
import { PUBLIC_PREMIUM_PLAN_ID } from 'astro:env/client'

// Obtener datos del usuario de la sesión
let user = await getSessionUser(Astro.session);
let subscription = await getSessionSubscription(Astro.session);

// Si no hay suscripción en la sesión, intentar refrescar los datos
if (user && !subscription) {
  try {
    const refreshResult = await Astro.callAction(server.auth.refreshUserData, {});
    if (refreshResult.data?.success && refreshResult.data?.data?.subscription) {
      subscription = refreshResult.data.data.subscription;
    }
  } catch (error) {
    // Error silencioso - el correo simplemente no se enviará
  }
}

// Verificar si ya se envió el correo de bienvenida (usando cookie)
const welcomeEmailSent = Astro.cookies.get('welcome_email_sent')?.value === 'true';

// Determinar si es plan premium (usando variable de entorno o amount > 0)
const isPremium = subscription?.plan_id === PUBLIC_PREMIUM_PLAN_ID || (subscription?.amount && Number(subscription.amount) > 0);

// Enviar correo de bienvenida SOLO si:
// 1. Tenemos datos del usuario
// 2. Es plan premium
// 3. No se ha enviado antes (evitar duplicados)
if (user?.email && user?.name && isPremium && !welcomeEmailSent) {
  // Marcar como enviado inmediatamente (cookie válida por 30 días)
  Astro.cookies.set('welcome_email_sent', 'true', {
    path: '/',
    maxAge: 60 * 60 * 24 * 30, // 30 días
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: 'lax'
  });

  // Enviar correo en background para no bloquear la carga
  sendWelcomePremiumEmailInternal(user.email, user.name).catch(() => {
    // Error silencioso - no bloquear la experiencia del usuario
  });
}
---

<Layout
  title="Bienvenida - Dominican HCI Club"
  description="Bienvenida al Dominican HCI Club"
>
  <div class="min-h-screen bg-background flex items-start justify-center p-4 pt-4">
    <div class="w-full max-w-3xl">
      <Card client:load>
        <CardHeader client:load className="pt-4 pb-0">
          <CardTitle client:load className="text-3xl md:text-4xl font-bold text-[#192a6e] text-left">
            ¡Aquí es donde inicias! 🌱
          </CardTitle>
        </CardHeader>
        <CardContent client:load className="space-y-4 text-lg leading-relaxed pt-4">
          <p class="text-foreground">
            En menos de 24 horas recibirás en tu correo la invitación para unirte a nuestro espacio de crecimiento en{" "}
            <span class="font-semibold">Pumble</span>. Allí podrás participar en seminarios ilimitados, debates y
            proyectos colaborativos sobre la Investigación y el Diseño de Experiencia de Usuario, fundamentados en la
            Interacción Humano-Computadora (IHC). Destacando también tu acceso ilimitado a recursos académicos curados
            especialmente para ti y mucho más.
          </p>

          <p class="text-foreground">
            Todo esto porque nos emociona ser parte de este camino en el que transformas tus conocimientos en
            práctica, en equipo, junto a más innovadores que también se están fortaleciendo desde la experiencia con
            nuestro apoyo.
          </p>

          <p class="text-foreground">Nos vemos en breve dentro del club para tu bienvenida 🤍</p>

          <div class="pt-3 border-t border-border">
            <p class="text-foreground">Con aprecio,</p>
            <p class="font-semibold text-foreground">Marilenny Soriano</p>
            <p class="text-muted-foreground">Fundadora</p>
          </div>
        </CardContent>
        <CardFooter client:load className="flex justify-center pt-4">
          <ButtonWelcomeCard />
        </CardFooter>
      </Card>
    </div>
  </div>
</Layout>
