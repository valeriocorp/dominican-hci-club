---
import Layout from '@/layouts/Layout.astro'
import ProfilePage from '@/components/ProfilePage'
import { hasActiveMembership } from '@/utils/sessionHelpers'

// Obtener datos del usuario desde locals (poblados por middleware)
const { isLoggedIn } = Astro.locals;

// Obtener datos completos del usuario y suscripción desde la sesión
const user = await Astro.session?.get('user');
const subscription = await Astro.session?.get('subscription');

// Si no hay usuario, el middleware ya debería haber redirigido
// pero agregamos verificación por seguridad
if (!isLoggedIn || !user) {
  return Astro.redirect('/login');
}

// Premium-only: la ausencia de suscripción premium activa NO es acceso "free".
// Un miembro activo es redirigido por el middleware a /profile-premium; aquí
// solo llegan usuarios sin membresía, que ven el estado de pago pendiente.
const isMember = hasActiveMembership(subscription);
---

<Layout
  title="Mi Perfil - Dominican HCI Club"
  description="Gestiona tu cuenta y suscripción del Dominican HCI Club"
>
  <ProfilePage
    client:load
    user={user}
    isLoggedIn={isLoggedIn}
    isMember={isMember}
  />
</Layout>
