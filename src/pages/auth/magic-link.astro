---
import Layout from '@/layouts/Layout.astro'
import { actions } from 'astro:actions'

const token = Astro.url.searchParams.get('token')

let errorMessage: string | null = null

if (!token) {
  errorMessage = 'El enlace no es válido. Solicita uno nuevo desde la página de inicio de sesión.'
} else {
  const { data, error } = await Astro.callAction(actions.auth.verifyMagicLink, { token })
  if (!error && data?.success) {
    return Astro.redirect('/profile')
  }
  errorMessage =
    (error && 'message' in error && error.message) ||
    'El enlace no es válido o ya expiró. Solicita uno nuevo.'
}
---

<Layout
  title="Verificando enlace - Dominican HCI Club"
  description="Verificación de enlace de inicio de sesión"
>
  <main class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="max-w-md w-full text-center space-y-4 py-16">
      <h1 class="text-2xl font-semibold">No pudimos iniciar tu sesión</h1>
      <p class="text-base opacity-80">{errorMessage}</p>
      <a
        href="/login"
        class="inline-block mt-4 px-6 py-3 rounded-lg bg-black text-white font-medium"
      >
        Volver a iniciar sesión
      </a>
    </div>
  </main>
</Layout>
